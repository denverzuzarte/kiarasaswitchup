-        imul    rax, r11
-        mov     r11, rax
-        shr     r11, 33
-        xor     rax, r11
-        movabs  r11, 0xC4CEB9FE1A85EC53
-        imul    rax, r11
-        mov     r11, rax
-        shr     r11, 33
-        xor     rax, r11
+        cmp     r11d, 0xFF
