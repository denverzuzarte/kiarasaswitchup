+        mov     r11, rsi
+        shr     r11, 56
         xor     eax, eax
-.Lkh_mix:
-        movabs  r11, 0x9E3779B97F4A7C15
-        imul    rax, r11
-        xor     rax, rsi
-        mov     r11, rax
-        shr     r11, 33
-        xor     rax, r11
