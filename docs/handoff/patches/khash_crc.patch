 # uint64_t evx_khash(uint64_t k0 /*rdi*/, uint64_t k1 /*rsi*/)
-#   Table index hash of a Key16: fmix64(k0 * K ^ k1); a long key hashes k1
+#   Table index hash of a Key16: CRC32C(k0, k1) (low 32 bits); a long key hashes k1
